# Server
PORT=3002

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT — change this to a long random string in production
JWT_SECRET=eco_vijay_jwt_secret_change_this_in_production

# Optional: SendGrid for email notifications
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@eco-vijay.com

# Optional: Twilio for WhatsApp/SMS quotation delivery
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1234567890

# Optional: Google Maps Geocoding API
GOOGLE_GEOCODING_API_KEY=your_google_geocoding_api_key_here
